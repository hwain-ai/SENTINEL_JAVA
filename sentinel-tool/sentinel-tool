#!/usr/bin/python3 -I
"""SENTINEL tool-protocol adapter for the Java checker.

Reads one sentinel-tool-protocol-v1 request from stdin and, from the checker
repository named in the sibling ``home`` file, runs in order: a Maven test run
with the locked JaCoCo agent on a disposable copy of the project, the JaCoCo XML
report, the CRAP gate (SelfCrapMain) and the mutate4java mutation gate
(MutationCommandMain). Exactly one response is written to stdout; every child's
output goes to a temporary log.
"""

import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path


STATUS_BY_EXIT = {
    0: "passed",
    1: "toolError",
    2: "qualityFailed",
    3: "usageConfigError",
    4: "baselineFailed",
    5: "dependencyError",
    6: "backendError",
    7: "evidenceError",
}
IDENTITY_KEYS = ("protocolVersion", "requestId", "command", "moduleId", "language")
# Same exclusions as ProjectSnapshot and ProductionInventory in the checker.
EXCLUDED_DIRECTORIES = {".git", ".sentinel", ".toolchain", "target", "build", "out", ".sentinel-tools", ".sentinel-m2"}
# Offline Maven repository that `scripts/mvn.sh deps` warms inside the project.
PROJECT_REPOSITORY = ".sentinel-m2"
MUTATION_TIMEOUT_MILLIS = "0"
CLI_PACKAGE = "io.github.hwainhwang.sentinel.cli"


def load_locks(home: Path) -> dict:
    """Resolved tool paths for this platform; the launcher's `paths` command owns the platform logic."""

    backend = json.loads((home / "backend.lock.json").read_text(encoding="utf-8"))
    backends = home / ".toolchain" / "backends"
    completed = subprocess.run(
        [sys.executable, "-I", "-B", str(home / "scripts" / "toolchain.py"), "paths"],
        stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, check=False, text=True,
    )
    if completed.returncode != 0:
        raise OSError("toolchain paths unavailable")
    paths = json.loads(completed.stdout)
    return {
        "java_home": Path(paths["javaHome"]),
        "maven_home": Path(paths["mavenHome"]),
        "repository": Path(paths["repository"]),
        "agent": backends / backend["artifacts"]["jacoco-agent"]["fileName"],
        "cli": backends / backend["artifacts"]["jacoco-cli"]["fileName"],
        "mutation_jar": backends / backend["mutationBackend"]["runtime"]["fileName"],
        "classes": home / "target" / "classes",
    }


def is_production(relative: str) -> bool:
    return relative.endswith(".java") and (relative.startswith("src/main/java/") or "/src/main/java/" in relative)


def production_sources(root: Path) -> list:
    found = []
    for current, directories, files in os.walk(root):
        directories[:] = sorted(name for name in directories if name not in EXCLUDED_DIRECTORIES)
        for name in files:
            relative = (Path(current) / name).relative_to(root).as_posix()
            if is_production(relative):
                found.append(relative)
    return sorted(found)


# SENTINEL-owned files next to the POM; they never enter a build tree so the project's own audits see its original tree.
SENTINEL_FILES = {"sentinel.workspace.json", "sentinel.config.json"}


def copy_project(root: Path, destination: Path) -> None:
    def ignore(directory, names):
        skipped = [n for n in names if n in EXCLUDED_DIRECTORIES]
        if Path(directory) == root:
            skipped += [n for n in names if n in SENTINEL_FILES]
        return skipped

    shutil.copytree(root, destination, ignore=ignore, symlinks=False)


def environment(locks: dict, home_directory: Path) -> dict:
    return {
        "HOME": str(home_directory),
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "PATH": f"{locks['java_home'] / 'bin'}:{locks['maven_home'] / 'bin'}:/usr/bin:/bin",
        "JAVA_HOME": str(locks["java_home"]),
        "MAVEN_HOME": str(locks["maven_home"]),
        "MAVEN_SKIP_RC": "true",
    }


def run(command: list, cwd: Path, env: dict, log, output=None) -> int:
    try:
        return subprocess.run(command, cwd=str(cwd), env=env, stdin=subprocess.DEVNULL, stdout=log if output is None else output, stderr=log, check=False).returncode
    except OSError:
        return 5


def maven_repository(locks: dict, project_root: Path) -> Path:
    project_repository = project_root / PROJECT_REPOSITORY
    return project_repository if project_repository.is_dir() else locks["repository"]


def crap_gate(locks: dict, repository: Path, snapshot: Path, env: dict, log, crap_max, only, functions=(), tests=(), output=None) -> int:
    java = str(locks["java_home"] / "bin" / "java")
    mvn = str(locks["maven_home"] / "bin" / "mvn")
    agent = f"-javaagent:{locks['agent']}=destfile=target/jacoco.exec,append=false"
    test_flags = ["-Dtest=" + ",".join(tests)] if tests else []
    if run([mvn, "-o", "-B", "-ntp", f"-Dmaven.repo.local={repository}", f"-DargLine={agent}", *test_flags, "test"], snapshot, env, log) != 0:
        return 1
    if not (snapshot / "target" / "jacoco.exec").is_file():
        return 1
    xml = snapshot / "target" / "sentinel-jacoco.xml"
    report = [java, "-jar", str(locks["cli"]), "--quiet", "report", "target/jacoco.exec",
              "--classfiles", "target/classes", "--sourcefiles", "src/main/java", "--encoding", "UTF-8", "--xml", str(xml)]
    if run(report, snapshot, env, log) != 0:
        return 1
    classpath = sorted(str(path) for path in repository.rglob("*.jar"))
    command = [java, "-cp", str(locks["classes"]), f"{CLI_PACKAGE}.SelfCrapMain"]
    if crap_max is not None:
        command += ["--crap-max", str(crap_max)]
    for path in only or ():
        command += ["--only", path]
    for function in functions:
        command += ["--function", function]
    command += [str(snapshot), "src/main/java", "target/sentinel-jacoco.xml", *classpath]
    return run(command, snapshot, env, log, output)


def mutation_gate(locks: dict, repository: Path, project_root: Path, inventory: Path, env: dict, log, mutation_min, targets, lines=(), tests=(), output=None) -> int:
    java = str(locks["java_home"] / "bin" / "java")
    command = [java, "-cp", str(locks["classes"]), f"{CLI_PACKAGE}.MutationCommandMain",
               "--project", str(project_root), "--inventory", str(inventory),
               "--backend", str(locks["mutation_jar"]), "--java-home", str(locks["java_home"]),
               "--maven-home", str(locks["maven_home"]), "--maven-repository", str(repository),
               "--listener", str(locks["classes"]), "--timeout-millis", MUTATION_TIMEOUT_MILLIS]
    if mutation_min is not None:
        command += ["--mutation-min", str(mutation_min)]
    for path in targets or ():
        command += ["--changed-file", path]
    if lines:
        command += ["--lines", ",".join(str(line) for line in lines)]
    if tests:
        command += ["--tests", ",".join(tests)]
    return run(command, project_root, env, log, output)


def test_classes(project_root, tests):
    classes = []
    for relative in tests:
        path = project_root / relative
        if not path.is_file() or path.is_symlink() or not path.resolve().is_relative_to(project_root.resolve()):
            raise ValueError("testSelectionInvalid")
        if "src/test/java/" not in relative or not relative.endswith(".java"):
            raise ValueError("testSelectionInvalid")
        name = relative.split("src/test/java/", 1)[1][:-5].replace("/", ".")
        if not re.fullmatch(r"[A-Za-z_$][A-Za-z0-9_$]*(\.[A-Za-z_$][A-Za-z0-9_$]*)*", name):
            raise ValueError("testSelectionInvalid")
        classes.append(name)
    return classes


def combined(crap_exit: int, mutation_exit: int) -> int:
    # Both Java entry points use 0 pass, 2 quality failure, 4 usage/tool failure.
    if crap_exit in (1, 5) or mutation_exit in (1, 5):
        return max(code for code in (crap_exit, mutation_exit) if code in (1, 5))
    if 4 in (crap_exit, mutation_exit):
        return 1
    if 2 in (crap_exit, mutation_exit):
        return 2
    return 0 if crap_exit == 0 and mutation_exit == 0 else 6


def main() -> int:
    here = Path(__file__).resolve().parent
    manifest = json.loads((here / "sentinel-tool.json").read_text(encoding="utf-8"))
    home = Path((here / "home").read_text(encoding="utf-8").splitlines()[0])
    request = json.load(sys.stdin)
    response = {key: request.get(key) for key in IDENTITY_KEYS}
    response["toolVersion"] = manifest["version"]
    if "selection" in request:
        response["selection"] = request["selection"]

    def finish(exit_code: int, *, no_changes: bool = False) -> int:
        status = "noChanges" if no_changes else STATUS_BY_EXIT.get(exit_code, "backendError")
        exit_code = 6 if status == "backendError" else exit_code
        response.update(status=status, exitCode=exit_code, passed=status == "passed")
        sys.stdout.write(json.dumps(response, separators=(",", ":")) + "\n")
        sys.stdout.flush()
        return exit_code

    if (
        request.get("protocolVersion") != "sentinel-tool-protocol-v1"
        or request.get("command") != "check"
        or request.get("language") != manifest["language"]
    ):
        return finish(3)
    project_root = Path(request["projectRoot"])
    if not (project_root / "pom.xml").is_file():
        return finish(3)
    gate = request.get("gate") or {}
    try:
        locks = load_locks(home)
    except (OSError, KeyError, ValueError):
        return finish(5)
    repository = maven_repository(locks, project_root)
    with tempfile.TemporaryDirectory(prefix="sentinel-tool-java-") as directory:
        work = Path(directory).resolve()  # macOS: /var is a symlink and the checker compares real paths
        sources = production_sources(project_root)
        if not sources:
            return finish(3)
        changed = request.get("changedFiles")
        targets = None
        selected = request.get("selection", {})
        functions = selected.get("functions", [])
        if selected.get("files"):
            targets = sorted(set(selected["files"]))
            if not set(targets) <= set(sources):
                return finish(3)
        if functions and (targets is None or len(targets) != 1):
            return finish(3)
        try:
            tests = test_classes(project_root, selected.get("tests", []))
        except ValueError:
            return finish(3)
        if changed is not None:
            # Changed mode: only changed production sources are judged; none means nothing to judge.
            targets = sorted(set(sources) & {str(path) for path in changed})
            if not targets:
                return finish(0, no_changes=True)
        inventory = work / "production.inventory"
        inventory.write_text("sentinel-java-production-v1\n" + "".join(f"{s}\n" for s in sources), encoding="utf-8")
        snapshot = work / "snapshot"
        copy_project(project_root, snapshot)
        home_directory = work / "home"
        home_directory.mkdir(mode=0o700)
        env = environment(locks, home_directory)
        with open(work / "checker.log", "wb") as log:
            with open(work / "crap.json", "wb") as output:
                crap_exit = crap_gate(locks, repository, snapshot, env, log, gate.get("crapMax"), targets, functions, tests, output)
            if crap_exit not in (0, 2):
                log.flush()
                failure_log = (work / "checker.log").read_text(errors="replace")
                if "self-crap error: functionSelectionInvalid" in failure_log:
                    response["diagnostic"] = "functionSelectionInvalid"
                    return finish(3)
                return finish(combined(crap_exit, 0))
            try:
                crap = json.loads((work / "crap.json").read_text())
                lines = sorted({line for item in crap["functions"] for line in range(item["line"], item["endLine"] + 1)}) if functions else []
                with open(work / "mutation.json", "wb") as output:
                    mutation_exit = mutation_gate(locks, repository, project_root, inventory, env, log, gate.get("mutationMin"), targets, lines, tests, output)
                if mutation_exit in (0, 2):
                    mutation = json.loads((work / "mutation.json").read_text())
                    for item in mutation.get("mutants", []):
                        owners = [row for row in crap["functions"] if row["file"] == item["file"] and row["line"] <= item["line"] <= row["endLine"]]
                        if owners:
                            item["function"] = min(owners, key=lambda row: row["endLine"] - row["line"])["function"]
                    response["details"] = {"scope": {"files": sources if targets is None else targets, "functions": functions, "tests": selected.get("tests", []), "testSelection": "explicit" if tests else "maven"}, "crap": crap, "mutation": mutation}
            except (OSError, ValueError, KeyError):
                return finish(6)
    return finish(combined(crap_exit, mutation_exit))


if __name__ == "__main__":
    sys.exit(main())
